{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision", "hypothesis", "evidence", "parent_sha", "plan_sha256", "analysis_sha256", "diff_sha256", "changed_files", "tests", "build", "skill_invocations", "risks", "stop_reason"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "decision": {"type": "string", "enum": ["candidate", "stop", "needs_evidence"]},
    "hypothesis": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "parent_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "analysis_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "diff_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "status", "exit_code", "notes"],
        "properties": {
          "name": {"type": "string"},
          "command": {"type": "string"},
          "status": {"type": "string", "enum": ["passed", "failed", "skipped", "inconclusive"]},
          "exit_code": {"type": ["integer", "null"]},
          "notes": {"type": "string"}
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "command", "exit_code", "notes"],
      "properties": {
        "status": {"type": "string", "enum": ["passed", "failed", "skipped", "inconclusive"]},
        "command": {"type": "string"},
        "exit_code": {"type": ["integer", "null"]},
        "notes": {"type": "string"}
      }
    },
    "skill_invocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "purpose", "status"],
        "properties": {
          "skill": {"type": "string"},
          "purpose": {"type": "string"},
          "status": {"type": "string", "enum": ["not_used", "used"]}
        }
      }
    },
    "stop_reason": {"type": ["string", "null"]},
    "risks": {"type": "array", "items": {"type": "string"}}
  }
}
